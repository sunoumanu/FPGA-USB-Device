// Physical Constraints File (CST) for Tang Nano 20k
// Adjust pin numbers based on your actual wiring!

// Clock (27MHz onboard oscillator)
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" PULL_MODE=UP;

// Reset Button (S1 or S2)
IO_LOC "button" 88; // S1 button
IO_PORT "button" PULL_MODE=UP;

// LEDs (Active Low)
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;

// USB Signals - CONNECT THESE TO YOUR USB BREAKOUT BOARD
// Example using pins 25, 26, 27. CHANGE THESE to match your wiring.
IO_LOC "usb_dp" 25;
IO_PORT "usb_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "usb_dn" 26;
IO_PORT "usb_dn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "usb_dp_pull" 27;
IO_PORT "usb_dp_pull" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Optional UART
IO_LOC "uart_tx" 69; // Pin 69 is often UART TX
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
